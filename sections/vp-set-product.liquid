{% comment %}
  Ficha de producto con formato "Individual / Set". Sirve para cualquier producto
  (camisetas, cinturones…) asignándole la plantilla templates/product.set.json.

  Cada producto define su set con metacampos (Productos → Metacampos):
  - custom.set_precio          Número entero. Precio del set en COP, sin puntos (ej. 229800).
                               Si está vacío, la ficha se muestra solo en formato individual.
  - custom.set_cantidad        Número entero. Piezas por set (2 a 6). Por defecto, el valor de la sección.
  - custom.set_nombre_plural   Texto. Cómo se llaman las piezas en plural (ej. "camisetas", "cinturones").

  El precio del set se cobra con un descuento automático configurado en el admin de Shopify;
  esta sección solo muestra ese precio y añade las piezas elegidas a la bolsa.
  Funciona con productos de hasta dos opciones: color y talla/medida (ambas opcionales).
{% endcomment %}

{{ 'vp-set-product.css' | asset_url | stylesheet_tag }}
<script src="{{ 'vp-set-product.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign color_option = null
  assign size_option = null
  for option in product.options_with_values
    assign option_name = option.name | downcase
    if option_name contains 'color' or option_name contains 'colour' or option_name contains 'tono' or option_name contains 'acabado'
      assign color_option = option
    elsif option_name contains 'talla' or option_name contains 'size' or option_name contains 'tamaño' or option_name contains 'medida' or option_name contains 'largo'
      assign size_option = option
    endif
  endfor

  assign current = product.selected_or_first_available_variant
  assign unit_cents = current.price

  assign set_qty = product.metafields.custom.set_cantidad.value | default: section.settings.set_quantity | plus: 0
  if set_qty < 2
    assign set_qty = 2
  elsif set_qty > 6
    assign set_qty = 6
  endif
  assign set_price = product.metafields.custom.set_precio.value | default: 0 | plus: 0
  assign set_cents = set_price | times: 100

  case set_qty
    when 2
      assign qty_word = 'dos'
    when 3
      assign qty_word = 'tres'
    when 4
      assign qty_word = 'cuatro'
    when 5
      assign qty_word = 'cinco'
    else
      assign qty_word = 'seis'
  endcase
  assign plural = product.metafields.custom.set_nombre_plural.value | default: section.settings.item_plural | downcase

  assign eyebrow = section.settings.eyebrow | default: product.type
  assign t_set_label = section.settings.set_label | replace: '[cantidad]', qty_word | replace: '[prendas]', plural
  assign t_ind_label = section.settings.individual_label
  if size_option
    assign t_set_sub = section.settings.set_subtitle
  else
    assign t_set_sub = section.settings.set_subtitle_no_size
  endif
  assign t_set_sub = t_set_sub | replace: '[cantidad]', qty_word | replace: '[prendas]', plural
  assign t_rows = section.settings.set_rows_heading | replace: '[cantidad]', qty_word | replace: '[prendas]', plural
  assign t_note_set = section.settings.note_set | replace: '[cantidad]', qty_word | replace: '[prendas]', plural
  assign t_note_ind = section.settings.note_individual | replace: '[cantidad]', qty_word | replace: '[prendas]', plural
  assign full_cents = unit_cents | times: set_qty
  assign saving_cents = full_cents | minus: set_cents
  assign per_unit_cents = set_cents | divided_by: set_qty

  assign default_format = section.settings.default_format
  if set_cents <= 0
    assign default_format = 'ind'
  endif

  assign images = product.media | where: 'media_type', 'image'

  assign set_money = set_cents | money
  assign unit_money = unit_cents | money
  assign cta_set_text = section.settings.cta_set | append: ' — ' | append: set_money
  assign cta_ind_text = section.settings.cta_individual | append: ' — ' | append: unit_money

  assign color_idx = 0
  assign size_idx = 0
  if color_option
    assign color_idx = color_option.position | minus: 1
  endif
  if size_option
    assign size_idx = size_option.position | minus: 1
  endif
-%}

<vp-set-product
  class="vps"
  id="VpSet-{{ section.id }}"
  data-default-format="{{ default_format }}"
>
  <script type="application/json" data-vps-json>
    {
      "hasColor": {% if color_option %}true{% else %}false{% endif %},
      "hasSize": {% if size_option %}true{% else %}false{% endif %},
      "sizeName": {{ size_option.name | default: 'Talla' | json }},
      "initialColor": {% if color_option %}{{ current.options[color_idx] | json }}{% else %}null{% endif %},
      "colors": [{% for value in color_option.values %}{{ value | json }}{% unless forloop.last %},{% endunless %}{% endfor %}],
      "variants": [
        {%- for variant in product.variants -%}
          {
            "id": {{ variant.id }},
            "c": {% if color_option %}{{ variant.options[color_idx] | json }}{% else %}null{% endif %},
            "s": {% if size_option %}{{ variant.options[size_idx] | json }}{% else %}null{% endif %},
            "a": {{ variant.available }},
            "m": {{ variant.featured_media.id | default: 'null' }}
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ],
      "strings": {
        "priceSet": {{ set_money | json }},
        "priceInd": {{ unit_money | json }},
        "labelSet": {{ t_set_label | json }},
        "labelInd": {{ t_ind_label | json }},
        "ctaSet": {{ cta_set_text | json }},
        "ctaInd": {{ cta_ind_text | json }},
        "added": {{ section.settings.cta_added | json }},
        "noteSet": {{ t_note_set | json }},
        "noteInd": {{ t_note_ind | json }},
        "missingRow": {{ section.settings.missing_row | json }},
        "missingInd": {{ section.settings.missing_individual | json }},
        "soldOut": {{ 'products.product.sold_out' | t | json }},
        "error": {{ 'sections.cart.cart_error' | t | json }}
      }
    }
  </script>

  <div class="vps__grid">
    <section class="vps__media" aria-label="Fotos de {{ product.title | escape }}">
      <div class="vps__track" tabindex="0">
        {%- for media in images -%}
          <div class="vps__slide" data-media-id="{{ media.id }}">
            {%- liquid
              assign loading = 'lazy'
              if forloop.first
                assign loading = 'eager'
              endif
              assign alt = media.alt | default: product.title | escape
            -%}
            {{
              media.preview_image
              | image_url: width: 2000
              | image_tag:
                widths: '600, 900, 1200, 1500, 2000',
                sizes: '(min-width: 900px) 55vw, 100vw',
                loading: loading,
                alt: alt
            }}
          </div>
        {%- else -%}
          <div class="vps__slide">{{ 'product-apparel-1' | placeholder_svg_tag: 'vps__placeholder' }}</div>
        {%- endfor -%}
      </div>
      {%- if images.size > 1 -%}
        <div class="vps__mbar">
          <span class="vps__count" aria-live="polite"><span data-vps-index>1</span> / {{ images.size }}</span>
          <div class="vps__arrows">
            <button type="button" data-vps-prev aria-label="Foto anterior">
              <svg viewBox="0 0 22 10" aria-hidden="true" focusable="false"><path d="M21 5H1M5 1L1 5l4 4"/></svg>
            </button>
            <button type="button" data-vps-next aria-label="Foto siguiente">
              <svg viewBox="0 0 22 10" aria-hidden="true" focusable="false"><path d="M1 5h20M17 1l4 4-4 4"/></svg>
            </button>
          </div>
        </div>
      {%- endif -%}
    </section>

    <div class="vps__info">
      <div class="vps__col">
        <div class="vps__head">
          {%- if eyebrow != blank -%}
            <p class="vps__eyebrow">{{ eyebrow }}</p>
          {%- endif -%}
          <h1 class="vps__title">{{ product.title }}</h1>
          <p class="vps__price">
            <span data-vps-price>{% if default_format == 'set' %}{{ set_cents | money }}{% else %}{{ unit_cents | money }}{% endif %}</span>
            <small data-vps-price-label>{% if default_format == 'set' %}{{ t_set_label }}{% else %}{{ t_ind_label }}{% endif %}</small>
          </p>
        </div>

        {%- liquid
          assign short = section.settings.short_description
          if short == blank
            assign short = product.description | strip_html | truncate: 200
          endif
        -%}
        {%- if short != blank -%}
          <p class="vps__desc">{{ short }}</p>
        {%- endif -%}

        {%- if set_cents > 0 -%}
          <div class="vps__block">
            <p class="vps__label">{{ section.settings.format_heading }}</p>
            <div class="vps__fmts" role="radiogroup" aria-label="{{ section.settings.format_heading | escape }}">
              <button type="button" class="vps-fmt" role="radio" data-fmt="ind" aria-checked="{% if default_format == 'ind' %}true{% else %}false{% endif %}">
                <span class="vps-fmt__t">{{ t_ind_label }}</span>
                <span class="vps-fmt__p">{{ unit_cents | money }}</span>
              </button>
              <button type="button" class="vps-fmt" role="radio" data-fmt="set" aria-checked="{% if default_format == 'set' %}true{% else %}false{% endif %}">
                <span class="vps-fmt__t">{{ t_set_label }}</span>
                <span class="vps-fmt__p">{{ set_cents | money }}</span>
                <span class="vps-fmt__s">{{ t_set_sub }}</span>
                <span class="vps-fmt__x">
                  {{- per_unit_cents | money }} c/u
                  {%- if saving_cents > 0 %} · ahorro total de {{ saving_cents | money }}{% endif -%}
                </span>
              </button>
            </div>
          </div>

          <div class="vps__block" data-vps-panel="set"{% if default_format != 'set' %} hidden{% endif %}>
            {%- if t_rows != blank -%}
              <p class="vps__label">{{ t_rows }}</p>
            {%- endif -%}
            <div class="vps-rows">
              {%- for i in (1..set_qty) -%}
                {%- assign idx = forloop.index0 -%}
                <div class="vps-row" data-row="{{ idx }}">
                  <button
                    type="button"
                    class="vps-row__head"
                    id="VpSetHead-{{ section.id }}-{{ idx }}"
                    aria-controls="VpSetBody-{{ section.id }}-{{ idx }}"
                    aria-expanded="false"
                    data-row-toggle="{{ idx }}"
                  >
                    <span class="vps-row__num">{% if i < 10 %}0{% endif %}{{ i }}</span>
                    <span class="vps-row__dot" aria-hidden="true"></span>
                    <span class="vps-row__sum" data-row-sum></span>
                    <span class="vps-pm" aria-hidden="true"></span>
                  </button>
                  <div
                    class="vps-row__body"
                    id="VpSetBody-{{ section.id }}-{{ idx }}"
                    role="region"
                    aria-labelledby="VpSetHead-{{ section.id }}-{{ idx }}"
                  >
                    <div class="vps-row__inner">
                      {%- render 'vp-set-picker',
                        scope: idx,
                        color_option: color_option,
                        size_option: size_option,
                        size_guide_url: section.settings.size_guide_url
                      -%}
                    </div>
                  </div>
                </div>
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}

        <div class="vps__block" data-vps-panel="ind"{% if default_format == 'set' %} hidden{% endif %}>
          {%- render 'vp-set-picker',
            scope: 'ind',
            color_option: color_option,
            size_option: size_option,
            size_guide_url: section.settings.size_guide_url
          -%}
        </div>

        <div class="vps__buy">
          <button type="button" class="vps__cta" data-vps-cta{% unless product.available %} disabled{% endunless %}>
            {%- if product.available -%}
              {%- if default_format == 'set' -%}{{ cta_set_text }}{%- else -%}{{ cta_ind_text }}{%- endif -%}
            {%- else -%}
              {{ 'products.product.sold_out' | t }}
            {%- endif -%}
          </button>
          <p class="vps__note" data-vps-note aria-live="polite">
            {%- if default_format == 'set' -%}
              {{ t_note_set }}
            {%- else -%}
              {{ t_note_ind }}
            {%- endif -%}
          </p>
        </div>

        <div class="vps-acc">
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when '@app' -%}
                <div class="vps-acc__app" {{ block.shopify_attributes }}>{% render block %}</div>
              {%- when 'custom_liquid' -%}
                <div class="vps-acc__app" {{ block.shopify_attributes }}>{{ block.settings.custom_liquid }}</div>
              {%- when 'collapsible_tab' -%}
                {%- liquid
                  if block.settings.only_with_size and size_option == null
                    continue
                  endif
                  assign mf_html = ''
                  assign mf_key = block.settings.metafield | strip
                  if mf_key contains '.'
                    assign mf_parts = mf_key | split: '.'
                    assign mf = product.metafields[mf_parts[0]][mf_parts[1]]
                    if mf.type contains 'rich_text'
                      assign mf_html = mf | metafield_tag
                    elsif mf != blank
                      assign mf_html = mf.value | newline_to_br
                    endif
                  endif
                  capture acc_body
                    if block.settings.use_product_description
                      echo product.description
                    endif
                    echo mf_html
                    if mf_html == blank
                      echo block.settings.content
                    endif
                    echo block.settings.page.content
                  endcapture
                  if acc_body == blank
                    continue
                  endif
                -%}
                <details class="vps-acc__item" {{ block.shopify_attributes }}>
                  <summary>
                    {{- block.settings.heading -}}
                    <span class="vps-pm" aria-hidden="true"></span>
                  </summary>
                  <div class="vps-acc__body rte">{{ acc_body }}</div>
                </details>
            {%- endcase -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
</vp-set-product>

{% schema %}
{
  "name": "Ficha con set",
  "tag": "section",
  "class": "section vps-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "El precio y la cantidad de cada set se definen en el producto con los metacampos custom.set_precio, custom.set_cantidad y custom.set_nombre_plural. El precio se cobra con un descuento automático en Shopify (Descuentos → Monto de descuento en productos, cantidad mínima igual al tamaño del set)."
    },
    {
      "type": "range",
      "id": "set_quantity",
      "label": "Piezas por set (si el producto no lo define)",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 3
    },
    {
      "type": "text",
      "id": "item_plural",
      "label": "Nombre de las piezas en plural (si el producto no lo define)",
      "default": "piezas"
    },
    {
      "type": "select",
      "id": "default_format",
      "label": "Formato seleccionado por defecto",
      "options": [
        { "value": "set", "label": "Set" },
        { "value": "ind", "label": "Individual" }
      ],
      "default": "set"
    },
    {
      "type": "header",
      "content": "Textos"
    },
    {
      "type": "paragraph",
      "content": "[cantidad] se reemplaza por la cantidad en letras (tres) y [prendas] por el nombre en plural (camisetas)."
    },
    { "type": "text", "id": "eyebrow", "label": "Categoría", "info": "Si se deja vacía, se usa el tipo de producto." },
    {
      "type": "textarea",
      "id": "short_description",
      "label": "Descripción corta",
      "info": "Si se deja vacía, se usa el inicio de la descripción del producto."
    },
    { "type": "text", "id": "format_heading", "label": "Título de formato", "default": "Formato" },
    { "type": "text", "id": "individual_label", "label": "Nombre del formato individual", "default": "Individual" },
    { "type": "text", "id": "set_label", "label": "Nombre del set", "default": "Set de [cantidad]" },
    { "type": "text", "id": "set_subtitle", "label": "Subtítulo del set", "default": "Elige color y talla de cada pieza" },
    { "type": "text", "id": "set_subtitle_no_size", "label": "Subtítulo del set (productos sin talla)", "default": "Elige el color de cada pieza" },
    { "type": "text", "id": "set_rows_heading", "label": "Título del selector del set", "default": "Tus [cantidad] [prendas]" },
    { "type": "text", "id": "cta_set", "label": "Botón (set)", "default": "Añadir el set" },
    { "type": "text", "id": "cta_individual", "label": "Botón (individual)", "default": "Añadir a la bolsa" },
    { "type": "text", "id": "cta_added", "label": "Botón tras añadir", "default": "Añadido a tu bolsa" },
    {
      "type": "text",
      "id": "note_set",
      "label": "Nota bajo el botón (set)",
      "default": "El precio del set se aplica automáticamente en tu bolsa."
    },
    {
      "type": "text",
      "id": "note_individual",
      "label": "Nota bajo el botón (individual)",
      "default": "Si llevas [cantidad], el precio del set se aplica automáticamente en tu bolsa."
    },
    {
      "type": "text",
      "id": "missing_row",
      "label": "Aviso de talla pendiente en el set",
      "default": "Elige la talla de la pieza [n].",
      "info": "[n] se reemplaza por el número de la fila."
    },
    { "type": "text", "id": "missing_individual", "label": "Aviso de talla pendiente (individual)", "default": "Elige una talla." },
    { "type": "url", "id": "size_guide_url", "label": "Enlace a la guía de tallas" }
  ],
  "blocks": [
    { "type": "@app" },
    {
      "type": "collapsible_tab",
      "name": "Acordeón",
      "settings": [
        { "type": "text", "id": "heading", "label": "Título", "default": "Detalles" },
        { "type": "checkbox", "id": "use_product_description", "label": "Mostrar la descripción del producto", "default": false },
        {
          "type": "text",
          "id": "metafield",
          "label": "Metacampo del producto",
          "info": "Ej. custom.cuidados. Si el producto lo tiene, reemplaza el contenido de abajo."
        },
        { "type": "richtext", "id": "content", "label": "Contenido" },
        { "type": "page", "id": "page", "label": "Contenido de una página" },
        { "type": "checkbox", "id": "only_with_size", "label": "Mostrar solo en productos con talla", "default": false }
      ]
    },
    {
      "type": "custom_liquid",
      "name": "Liquid personalizado",
      "settings": [{ "type": "liquid", "id": "custom_liquid", "label": "Liquid" }]
    }
  ]
}
{% endschema %}
