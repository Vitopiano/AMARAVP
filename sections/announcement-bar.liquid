{%- liquid
  assign social_icons = true
  if settings.social_facebook_link == blank and settings.social_instagram_link == blank and settings.social_youtube_link == blank and settings.social_tiktok_link == blank and settings.social_twitter_link == blank and settings.social_pinterest_link == blank and settings.social_snapchat_link == blank and settings.social_tumblr_link == blank and settings.social_vimeo_link == blank
    assign social_icons = false
  endif
  if section.settings.enable_country_selector or section.settings.enable_language_selector
    assign language_country_selector = true
  endif
  assign is_product_page = false
  if request.page_type == 'product' and section.settings.product_page_text != blank
    assign is_product_page = true
  endif
  if section.blocks.size > 0 or is_product_page
    assign announcement_bar = true
  endif
  assign marquee_mode = false
  if section.blocks.size > 1
    assign marquee_mode = true
  endif
-%}

{% if social_icons %}
  {{ 'component-list-social.css' | asset_url | stylesheet_tag }}
{% endif %}

{%- if marquee_mode -%}
  <style>
    #vito-ticker-{{ section.id }} {
      background: rgb(var(--color-background));
      overflow: hidden;
    }
    #vito-ticker-{{ section.id }} .vito-ticker__track {
      display: flex;
      align-items: center;
      width: max-content;
      animation: vito-ticker-scroll-{{ section.id }} {{ section.settings.ticker_speed }}s linear infinite;
    }
    #vito-ticker-{{ section.id }} .vito-ticker__item {
      display: inline-flex;
      align-items: center;
      padding: 1.4rem 0;
      font-size: 1.1rem;
      letter-spacing: 0.3em;
      text-transform: uppercase;
      white-space: nowrap;
      color: rgb(var(--color-foreground));
    }
    #vito-ticker-{{ section.id }} .vito-ticker__item--accent {
      color: rgb(var(--color-link));
    }
    #vito-ticker-{{ section.id }} .vito-ticker__dot {
      display: inline-block;
      margin: 0 2.4rem;
      color: rgb(var(--color-foreground));
      opacity: 0.5;
    }
    @keyframes vito-ticker-scroll-{{ section.id }} {
      0% { transform: translateX(0); }
      100% { transform: translateX(-50%); }
    }
    @media screen and (max-width: 749px) {
      #vito-ticker-{{ section.id }} .vito-ticker__item {
        font-size: 0.95rem;
        letter-spacing: 0.18em;
      }
      #vito-ticker-{{ section.id }} .vito-ticker__dot {
        margin: 0 1.6rem;
      }
    }
    @media (prefers-reduced-motion: reduce) {
      #vito-ticker-{{ section.id }} .vito-ticker__track {
        animation: none;
        overflow-x: auto;
      }
    }
  </style>
  <div
    id="vito-ticker-{{ section.id }}"
    class="vito-ticker color-{{ section.settings.color_scheme }}"
    role="region"
    aria-label="{{ 'sections.header.announcement' | t }}"
    {{ block.shopify_attributes }}
  >
    <div class="vito-ticker__track">
      {%- for i in (1..2) -%}
        {%- for ticker_block in section.blocks -%}
          <span class="vito-ticker__item{% if ticker_block.settings.highlight %} vito-ticker__item--accent{% endif %}"{% if i == 2 %} aria-hidden="true"{% endif %} {{ ticker_block.shopify_attributes }}>{{ ticker_block.settings.text | escape }}</span>
          <span class="vito-ticker__dot" aria-hidden="true">&middot;</span>
        {%- endfor -%}
      {%- endfor -%}
    </div>
  </div>
{%- else -%}
<div
  class="utility-bar color-{{ section.settings.color_scheme }} gradient{% if section.settings.show_line_separator and section.blocks.size > 0 %} utility-bar--bottom-border{% elsif section.settings.show_line_separator and section.settings.show_social and social_icons%} utility-bar--bottom-border-social-only{% endif %}{% if section.settings.enable_country_selector or section.settings.enable_language_selector %} header-localization{% endif %}"
  {{ block.shopify_attributes }}
>
  <div class="page-width utility-bar__grid{% if announcement_bar and language_country_selector or section.settings.show_social and social_icons %} utility-bar__grid--3-col{% elsif language_country_selector or section.settings.show_social and social_icons %} utility-bar__grid--2-col{% endif %}">
    {%- if section.settings.show_social and social_icons -%}
      {%- render 'social-icons' -%}
    {%- endif -%}
    {%- if is_product_page -%}
      <div
        class="announcement-bar announcement-bar--one-announcement"
        role="region"
        aria-label="Información de envío"
      >
        {%- if section.settings.product_page_link != blank -%}
          <a href="{{ section.settings.product_page_link }}" class="announcement-bar__link link link--text focus-inset animate-arrow">
        {%- endif -%}
        <p class="announcement-bar__message h5">
          <span>{{ section.settings.product_page_text | escape }}</span>
          {%- if section.settings.product_page_link != blank -%}
            {{- 'icon-arrow.svg' | inline_asset_content -}}
          {%- endif -%}
        </p>
        {%- if section.settings.product_page_link != blank -%}
          </a>
        {%- endif -%}
      </div>
    {%- elsif section.blocks.size == 1 -%}
      <div
        class="announcement-bar{% if section.settings.show_social %} announcement-bar--one-announcement{% endif %}"
        role="region"
        aria-label="{{ 'sections.header.announcement' | t }}"
        {{ block.shopify_attributes }}
      >
        {%- if section.blocks.first.settings.text != blank -%}
          {%- if section.blocks.first.settings.link != blank -%}
            <a
              href="{{ section.blocks.first.settings.link }}"
              class="announcement-bar__link link link--text focus-inset animate-arrow"
            >
          {%- endif -%}
          <p class="announcement-bar__message h5">
            <span>{{ section.blocks.first.settings.text | escape }}</span>
            {%- if section.blocks.first.settings.link != blank -%}
              {{- 'icon-arrow.svg' | inline_asset_content -}}
            {%- endif -%}
          </p>
          {%- if section.blocks.first.settings.link != blank -%}
            </a>
          {%- endif -%}
        {%- endif -%}
      </div>
    {%- endif -%}
    <div class="localization-wrapper">
      {%- if section.settings.enable_country_selector and localization.available_countries.size > 1 -%}
        <localization-form class="small-hide medium-hide">
          {%- form 'localization', id: 'AnnouncementCountryForm', class: 'localization-form' -%}
            <div>
              <h2 class="visually-hidden" id="AnnouncementCountryLabel">{{ 'localization.country_label' | t }}</h2>
              {%- render 'country-localization', localPosition: 'AnnouncementCountry' -%}
            </div>
          {%- endform -%}
        </localization-form>
      {% endif %}

      {%- if section.settings.enable_language_selector and localization.available_languages.size > 1 -%}
        <localization-form class="small-hide medium-hide">
          {%- form 'localization', id: 'AnnouncementLanguageForm', class: 'localization-form' -%}
            <div>
              <h2 class="visually-hidden" id="AnnouncementLanguageLabel">{{ 'localization.language_label' | t }}</h2>
              {%- render 'language-localization', localPosition: 'AnnouncementLanguage' -%}
            </div>
          {%- endform -%}
        </localization-form>
      {%- endif -%}
    </div>
  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.announcement-bar.name",
  "max_blocks": 12,
  "class": "announcement-bar-section",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "info": "En modo ticker (2+ bloques) define fondo, texto y color de las frases resaltadas.",
      "default": "vito-negro"
    },
    {
      "type": "header",
      "content": "Anuncio exclusivo para páginas de producto"
    },
    {
      "type": "text",
      "id": "product_page_text",
      "label": "Texto del anuncio (páginas de producto)",
      "default": "Envío gratis en compras mayores a $600.000"
    },
    {
      "type": "url",
      "id": "product_page_link",
      "label": "Enlace del anuncio (opcional)"
    },
    {
      "type": "checkbox",
      "id": "show_line_separator",
      "default": true,
      "label": "t:sections.header.settings.show_line_separator.label"
    },
    {
      "type": "header",
      "content": "t:sections.announcement-bar.settings.header__1.content",
      "info": "t:sections.announcement-bar.settings.header__1.info"
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "default": false,
      "label": "t:sections.announcement-bar.settings.show_social.label"
    },
    {
      "type": "header",
      "content": "Ticker (2 o más bloques)"
    },
    {
      "type": "paragraph",
      "content": "Con 2 o más bloques de anuncio, la barra se vuelve una marquesina continua en lugar de un carrusel."
    },
    {
      "type": "range",
      "id": "ticker_speed",
      "min": 10,
      "max": 90,
      "step": 5,
      "unit": "s",
      "label": "Duración del ciclo",
      "default": 40
    },
    {
      "type": "header",
      "content": "t:sections.announcement-bar.settings.header__3.content",
      "info": "t:sections.announcement-bar.settings.header__3.info"
    },
    {
      "type": "checkbox",
      "id": "enable_country_selector",
      "default": false,
      "label": "t:sections.announcement-bar.settings.enable_country_selector.label"
    },
    {
      "type": "header",
      "content": "t:sections.announcement-bar.settings.header__4.content",
      "info": "t:sections.announcement-bar.settings.header__4.info"
    },
    {
      "type": "checkbox",
      "id": "enable_language_selector",
      "default": false,
      "label": "t:sections.announcement-bar.settings.enable_language_selector.label"
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "t:sections.announcement-bar.blocks.announcement.name",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "default": "t:sections.announcement-bar.blocks.announcement.settings.text.default",
          "label": "t:sections.announcement-bar.blocks.announcement.settings.text.label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.announcement-bar.blocks.announcement.settings.link.label"
        },
        {
          "type": "checkbox",
          "id": "highlight",
          "label": "Resaltar en color de acento (solo modo ticker)",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.announcement-bar.presets.name",
      "blocks": [
        {
          "type": "announcement",
          "settings": {
            "text": "Envío gratis en compras superiores a $600.000"
          }
        },
        {
          "type": "announcement",
          "settings": {
            "text": "El origen de tu estilo",
            "highlight": true
          }
        },
        {
          "type": "announcement",
          "settings": {
            "text": "Colombian craftsmanship meets Italian precision"
          }
        },
        {
          "type": "announcement",
          "settings": {
            "text": "Italian & Colombian Slow Fashion Store",
            "highlight": true
          }
        },
        {
          "type": "announcement",
          "settings": {
            "text": "Tejer lo mejor de dos mundos"
          }
        },
        {
          "type": "announcement",
          "settings": {
            "text": "Bogotá · Italia · 2026",
            "highlight": true
          }
        }
      ]
    }
  ]
}
{% endschema %}
