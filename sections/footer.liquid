<style>
  .vf {
    background: rgb(var(--color-background));
    color: rgb(var(--color-foreground));
    padding: 5.6rem 2.4rem 2.4rem;
    font-family: 'Inter', sans-serif;
  }

  .vf__grid {
    max-width: 1300px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: 3.2rem;
    margin-bottom: 4.8rem;
  }

  .vf__logo {
    font-family: 'Cormorant Garamond', serif;
    font-size: 2.2rem;
    letter-spacing: 0.2em;
    margin: 0 0 1.2rem;
    color: rgb(var(--color-foreground));
  }

  .vf__logo img {
    max-width: 160px;
    height: auto;
    display: block;
  }

  .vf__tagline {
    font-style: italic;
    color: rgb(var(--color-link));
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.6rem;
    margin: 0 0 1.6rem;
  }

  .vf__desc {
    font-size: 1.3rem;
    line-height: 1.7;
    color: rgba(var(--color-foreground), 0.6);
    max-width: 32rem;
    margin: 0;
  }

  .vf__col h4 {
    font-size: 1rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    margin: 0 0 1.6rem;
    color: rgb(var(--color-link));
  }

  .vf__col a {
    display: block;
    color: rgba(var(--color-foreground), 0.7);
    font-size: 1.3rem;
    text-decoration: none;
    margin-bottom: 1rem;
  }

  .vf__col a:hover {
    color: rgb(var(--color-foreground));
  }

  .vf__bottom {
    max-width: 1300px;
    margin: 0 auto;
    padding-top: 2.4rem;
    border-top: 1px solid rgba(var(--color-foreground), 0.1);
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.6rem 1.6rem;
    font-size: 1.1rem;
    color: rgba(var(--color-foreground), 0.4);
    letter-spacing: 0.05em;
  }

  .vf__bottom-left {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  @media screen and (max-width: 749px) {
    .vf {
      padding: 4.8rem 1.6rem 2.4rem;
    }

    .vf__grid {
      grid-template-columns: 1fr 1fr;
      gap: 3.2rem 1.6rem;
    }

    .vf__grid > :first-child {
      grid-column: 1 / -1;
    }

    .vf__bottom {
      flex-direction: column;
    }
  }
</style>

<footer class="vf color-{{ section.settings.color_scheme }}">
  <div class="vf__grid">
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'brand' -%}
          <div {{ block.shopify_attributes }}>
            {%- if block.settings.logo != blank -%}
              <div class="vf__logo">{{ block.settings.logo | image_url: width: 320 | image_tag: loading: 'lazy', alt: block.settings.brand_name }}</div>
            {%- else -%}
              <p class="vf__logo">{{ block.settings.brand_name }}</p>
            {%- endif -%}
            {%- if block.settings.tagline != blank -%}
              <p class="vf__tagline">{{ block.settings.tagline }}</p>
            {%- endif -%}
            {%- if block.settings.description != blank -%}
              <p class="vf__desc">{{ block.settings.description }}</p>
            {%- endif -%}
          </div>
        {%- when 'link_column' -%}
          <div class="vf__col" {{ block.shopify_attributes }}>
            <h4>{{ block.settings.heading }}</h4>
            {%- for i in (1..4) -%}
              {%- liquid
                case i
                  when 1
                    assign link_text = block.settings.link_1_text
                    assign link_url = block.settings.link_1_url
                  when 2
                    assign link_text = block.settings.link_2_text
                    assign link_url = block.settings.link_2_url
                  when 3
                    assign link_text = block.settings.link_3_text
                    assign link_url = block.settings.link_3_url
                  when 4
                    assign link_text = block.settings.link_4_text
                    assign link_url = block.settings.link_4_url
                endcase
              -%}
              {%- if link_text != blank -%}
                <a href="{{ link_url | default: '#' }}">{{ link_text }}</a>
              {%- endif -%}
            {%- endfor -%}
          </div>
      {%- endcase -%}
    {%- endfor -%}
  </div>
  <div class="vf__bottom">
    <div class="vf__bottom-left">
      <span>{{ section.settings.copyright_text }}</span>
      {%- if section.settings.legal_text != blank -%}
        <span>{{ section.settings.legal_text }}</span>
      {%- endif -%}
    </div>
    <span>{{ section.settings.bottom_tagline }}</span>
  </div>
</footer>

{% schema %}
{
  "name": "Vito · Footer",
  "settings": [
    {
      "type": "text",
      "id": "copyright_text",
      "label": "Texto de copyright (izquierda)",
      "default": "© 2026 Vito Piano · Bogotá · Italia"
    },
    {
      "type": "text",
      "id": "legal_text",
      "label": "Texto legal (razón social / NIT)",
      "default": "Casa Vito SAS · NIT 901930137-9"
    },
    {
      "type": "text",
      "id": "bottom_tagline",
      "label": "Tagline inferior (derecha)",
      "default": "ITA & COL · Slow Fashion Store"
    },
    {
      "type": "header",
      "content": "Colores"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Esquema de colores",
      "info": "Fondo, texto y acento (títulos de columna + tagline) vienen del esquema.",
      "default": "vito-negro"
    }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "Marca (logo + descripción)",
      "limit": 1,
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo (opcional, si está vacío se usa el texto)"
        },
        {
          "type": "text",
          "id": "brand_name",
          "label": "Nombre de marca",
          "default": "VITO PIANO"
        },
        {
          "type": "text",
          "id": "tagline",
          "label": "Tagline",
          "default": "El origen de tu estilo"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Descripción",
          "default": "Slow Fashion Store italiano-colombiano. Chaquetería artesanal con paño italiano y alma de Bogotá. Hecho con tiempo, hecho para durar."
        }
      ]
    },
    {
      "type": "link_column",
      "name": "Columna de enlaces",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Título de columna",
          "default": "Comprar"
        },
        {
          "type": "text",
          "id": "link_1_text",
          "label": "Enlace 1 — texto",
          "default": "Chaquetas"
        },
        {
          "type": "url",
          "id": "link_1_url",
          "label": "Enlace 1 — URL"
        },
        {
          "type": "text",
          "id": "link_2_text",
          "label": "Enlace 2 — texto",
          "default": "Blazers"
        },
        {
          "type": "url",
          "id": "link_2_url",
          "label": "Enlace 2 — URL"
        },
        {
          "type": "text",
          "id": "link_3_text",
          "label": "Enlace 3 — texto",
          "default": "Camisas"
        },
        {
          "type": "url",
          "id": "link_3_url",
          "label": "Enlace 3 — URL"
        },
        {
          "type": "text",
          "id": "link_4_text",
          "label": "Enlace 4 — texto",
          "default": "Accesorios"
        },
        {
          "type": "url",
          "id": "link_4_url",
          "label": "Enlace 4 — URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Vito · Footer",
      "blocks": [
        { "type": "brand" },
        {
          "type": "link_column",
          "settings": {
            "heading": "Comprar",
            "link_1_text": "Chaquetas",
            "link_2_text": "Blazers",
            "link_3_text": "Camisas",
            "link_4_text": "Accesorios"
          }
        },
        {
          "type": "link_column",
          "settings": {
            "heading": "Vito Piano",
            "link_1_text": "El taller",
            "link_2_text": "Atelier privado",
            "link_3_text": "Journal",
            "link_4_text": "Garantía artesanal"
          }
        },
        {
          "type": "link_column",
          "settings": {
            "heading": "Contacto",
            "link_1_text": "ciao@vitopiano.com",
            "link_1_url": "mailto:ciao@vitopiano.com",
            "link_2_text": "WhatsApp",
            "link_3_text": "Instagram",
            "link_4_text": "Cambios y envíos"
          }
        }
      ]
    }
  ],
  "enabled_on": {
    "groups": ["footer"]
  }
}
{% endschema %}
