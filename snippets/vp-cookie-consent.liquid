{% comment %}
  Vito Piano — Aviso de cookies (versión 2, 01/11/26)
  Un solo botón: "Aceptar y continuar".
  Al aceptar, registra el consentimiento en Shopify (Customer Privacy API)
  para que quede constancia demostrable de cada autorización.
{% endcomment %}

<style>
  #vp-cookie-banner {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 9999;
    background-color: #431424;
    background-image:
      linear-gradient(rgba(197, 234, 255, 0.07) 1px, transparent 1px),
      linear-gradient(90deg, rgba(197, 234, 255, 0.07) 1px, transparent 1px);
    background-size: 48px 48px;
    border-top: 1px solid rgba(197, 234, 255, 0.15);
    padding: 2.8rem 3.2rem;
    display: none;
  }

  #vp-cookie-banner.is-visible {
    display: block;
  }

  .vp-cookie__inner {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 2.4rem 4rem;
    align-items: end;
  }

  .vp-cookie__header {
    display: flex;
    align-items: baseline;
    gap: 1.6rem;
    margin-bottom: 1.2rem;
  }

  .vp-cookie__title {
    font-family: 'Chivo Mono', 'Courier New', monospace;
    font-size: 1.0rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: rgba(197, 234, 255, 0.90);
    margin: 0;
  }

  .vp-cookie__body {
    font-family: 'Bricolage Grotesque', system-ui, sans-serif;
    font-size: 1.4rem;
    line-height: 1.65;
    color: rgba(252, 249, 245, 0.80);
    margin: 0;
  }

  .vp-cookie__body a {
    color: rgba(252, 249, 245, 0.95);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .vp-cookie__actions {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: stretch;
    min-width: 22rem;
  }

  .vp-cookie__btn {
    font-family: 'Chivo Mono', 'Courier New', monospace;
    font-size: 1.0rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    border: none;
    cursor: pointer;
    padding: 1.2rem 2rem;
    transition: opacity 0.2s ease;
    text-align: center;
    white-space: nowrap;
  }

  .vp-cookie__btn:hover {
    opacity: 0.85;
  }

  .vp-cookie__btn--accept {
    background: #FCF9F5;
    color: #431424;
  }

  @media screen and (max-width: 749px) {
    #vp-cookie-banner {
      padding: 2.4rem 2rem;
    }

    .vp-cookie__inner {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .vp-cookie__actions {
      min-width: 0;
    }

    .vp-cookie__btn {
      padding: 1.2rem 1rem;
      font-size: 0.9rem;
    }
  }
</style>

<div id="vp-cookie-banner" role="dialog" aria-label="Aviso de cookies" aria-live="polite">
  <div class="vp-cookie__inner">
    <div class="vp-cookie__content">
      <div class="vp-cookie__header">
        <p class="vp-cookie__title">Cookies · Vito Piano</p>
      </div>
      <p class="vp-cookie__body">
        Usamos cookies propias y de terceros para que la tienda funcione, analizar el tráfico y medir nuestra publicidad.
        Al hacer clic en "Aceptar y continuar" autorizas este uso según nuestra
        <a href="/policies/privacy-policy">política de privacidad</a>.
        Si no quieres que se usen, puedes bloquearlas o borrarlas desde tu navegador.
      </p>
    </div>
    <div class="vp-cookie__actions">
      <button type="button" class="vp-cookie__btn vp-cookie__btn--accept" id="vp-cookie-accept">
        Aceptar y continuar
      </button>
    </div>
  </div>
</div>

<script>
  (function () {
    // Clave nueva: quienes eligieron "Solo esenciales" en la versión anterior verán el aviso otra vez.
    var STORAGE_KEY = 'vp_cookie_consent_v2';
    var banner = document.getElementById('vp-cookie-banner');
    if (!banner) return;

    function hasConsent() {
      try { return localStorage.getItem(STORAGE_KEY) === 'accepted'; } catch (e) { return false; }
    }

    // Registra el consentimiento en Shopify para que quede constancia.
    function registerShopifyConsent() {
      if (!window.Shopify || typeof window.Shopify.loadFeatures !== 'function') return;
      window.Shopify.loadFeatures(
        [{ name: 'consent-tracking-api', version: '0.1' }],
        function (error) {
          if (error || !window.Shopify.customerPrivacy) return;
          window.Shopify.customerPrivacy.setTrackingConsent(
            { analytics: true, marketing: true, preferences: true, sale_of_data: false },
            function () {}
          );
        }
      );
    }

    function accept() {
      try {
        localStorage.setItem(STORAGE_KEY, 'accepted');
        localStorage.setItem(STORAGE_KEY + '_date', new Date().toISOString());
      } catch (e) {}
      banner.classList.remove('is-visible');
      registerShopifyConsent();
    }

    if (!hasConsent()) {
      banner.classList.add('is-visible');
    }

    document.getElementById('vp-cookie-accept').addEventListener('click', accept);
  })();
</script>
