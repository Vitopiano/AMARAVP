{%- comment -%}
  Vito Piano — Bloque de confianza bajo el botón de compra.
  Recibe: bb (bloque buy_buttons), product.
  Todos los textos se editan en el bloque "Botones de compra" del editor de temas.
{%- endcomment -%}
{%- if bb.settings.show_trust_bar -%}
  <style>
    .vp-trust { margin: 1.6rem 0 0.8rem; padding: 1.6rem 0; border-top: 1px solid rgba(12,68,51,0.12); border-bottom: 1px solid rgba(12,68,51,0.12); }
    .vp-trust__list { list-style: none; margin: 0; padding: 0; display: grid; gap: 1rem; }
    .vp-trust__item { display: flex; align-items: center; gap: 1.2rem; font-size: 1.3rem; line-height: 1.4; color: rgba(28,28,26,0.78); letter-spacing: 0.01em; }
    .vp-trust__item svg { flex: 0 0 1.8rem; width: 1.8rem; height: 1.8rem; stroke: #0C4433; fill: none; stroke-width: 1.4; stroke-linecap: round; stroke-linejoin: round; }
    .vp-trust__wa { margin-top: 1.4rem; display: flex; align-items: center; justify-content: center; gap: 1rem; width: 100%; min-height: 4.6rem; padding: 1rem 1.6rem; border: 1px solid #0C4433; color: #0C4433; background: transparent; text-decoration: none; font-family: 'Chivo Mono', 'Courier New', monospace; font-size: 1.1rem; letter-spacing: 0.12em; text-transform: uppercase; text-align: center; transition: background-color .2s ease, color .2s ease; }
    .vp-trust__wa svg { width: 1.8rem; height: 1.8rem; fill: currentColor; flex: 0 0 1.8rem; }
    .vp-trust__wa:hover, .vp-trust__wa:focus-visible { background: #0C4433; color: #FCF9F5; }
  </style>
  <div class="vp-trust">
    <ul class="vp-trust__list" role="list">
      {%- if bb.settings.shipping_text != blank -%}
        <li class="vp-trust__item">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2 6h11v10H2zM13 9h4.5L21 12.5V16h-8z"/><circle cx="6" cy="17.5" r="1.8"/><circle cx="17" cy="17.5" r="1.8"/></svg>
          <span>{{ bb.settings.shipping_text }}</span>
        </li>
      {%- endif -%}
      {%- if bb.settings.returns_text != blank -%}
        <li class="vp-trust__item">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9a8 8 0 0 1 14.5-3.5L20 7M20 3v4h-4M20 15a8 8 0 0 1-14.5 3.5L4 17M4 21v-4h4"/></svg>
          <span>{{ bb.settings.returns_text }}</span>
        </li>
      {%- endif -%}
      {%- if bb.settings.payment_text != blank -%}
        <li class="vp-trust__item">
          <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="2.5" y="5" width="19" height="14" rx="1.5"/><path d="M2.5 9.5h19M6 15h4"/></svg>
          <span>{{ bb.settings.payment_text }}</span>
        </li>
      {%- endif -%}
      {%- if bb.settings.origin_text != blank -%}
        <li class="vp-trust__item">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19 4 6.5 16.5M17 3.5l3.5 3.5M5 21c-1-1-1-3 1.5-4.5"/><circle cx="18.5" cy="5.5" r="0.8"/></svg>
          <span>{{ bb.settings.origin_text }}</span>
        </li>
      {%- endif -%}
    </ul>
    {%- if bb.settings.show_whatsapp and bb.settings.whatsapp_number != blank -%}
      {%- capture vp_wa_msg -%}Hola, me interesa la {{ product.title }}. ¿Me ayudan a elegir mi talla?{%- endcapture -%}
      <a class="vp-trust__wa" href="https://wa.me/{{ bb.settings.whatsapp_number | strip }}?text={{ vp_wa_msg | url_encode }}" target="_blank" rel="noopener noreferrer" data-vp-event="whatsapp_pdp">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12.05 0C5.5 0 .16 5.34.16 11.89c0 2.1.55 4.14 1.59 5.95L.06 24l6.3-1.65a11.9 11.9 0 0 0 5.69 1.45c6.55 0 11.89-5.34 11.89-11.9A11.8 11.8 0 0 0 12.05 0Zm0 21.79a9.9 9.9 0 0 1-5.03-1.38l-.36-.21-3.74.98 1-3.65-.24-.37a9.86 9.86 0 0 1-1.51-5.27c0-5.45 4.44-9.88 9.89-9.88a9.88 9.88 0 0 1 9.88 9.89c0 5.45-4.44 9.89-9.89 9.89Zm5.42-7.4c-.3-.15-1.760-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.16-.17.2-.35.23-.64.08-.3-.15-1.26-.47-2.4-1.48-.88-.79-1.48-1.76-1.65-2.06-.17-.3-.02-.46.13-.6.13-.14.3-.35.45-.52.15-.18.2-.3.3-.5.1-.2.05-.37-.03-.52-.07-.15-.67-1.61-.91-2.2-.25-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.48 0 1.46 1.07 2.88 1.21 3.07.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.7.63.71.22 1.36.19 1.87.12.57-.09 1.76-.72 2-1.42.25-.69.25-1.29.18-1.41-.08-.12-.28-.2-.57-.35Z"/></svg>
        <span>{{ bb.settings.whatsapp_label }}</span>
      </a>
    {%- endif -%}
  </div>
{%- endif -%}
